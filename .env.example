# =============================================================================
# FGreda - variables de entorno
# =============================================================================
# Copie este archivo a .env.local y ajuste el valor. .env* NUNCA se commitea.
#
# ATENCION: en Vite, toda variable con prefijo VITE_ queda incrustada en el
# bundle publico. Aqui solo puede figurar informacion no sensible.
#
# Este proyecto declara UNA sola variable a proposito. No debe existir ninguna
# URL ni clave de Supabase: el frontend habla exclusivamente con el backend.
# =============================================================================

# URL base del backend BGreda, sin barra final.
# Desarrollo local: http://localhost:8000
# Produccion: la URL del servicio de Cloud Run del backend.
VITE_API_BASE_URL=http://localhost:8000
