# ---- Secretos: nunca commitear ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Dependencias ----
node_modules/
.pnp
.pnp.js

# ---- Build ----
dist/
dist-ssr/
build/
*.local

# ---- Test / coverage ----
coverage/
.vitest/

# ---- Cache de herramientas ----
.eslintcache
.vite/
node_modules/.vite/

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Editores / SO ----
.vscode/
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Configuracion local de herramientas de desarrollo
.claude/

# Indice local del MCP de memoria de codigo: no es fuente del proyecto.
.codebase-memory/

# ---- Playwright ----
/playwright-report/
/test-results/
# Salidas de `playwright test --output=<dir>`: al pasar un directorio propio
# los artefactos caen fuera de /test-results/ y acaban en un commit.
/tr-*/
/blob-report/
# Por si algun dia se usa storageState: nunca versionar sesiones/cookies reales.
**/.auth/
