# Configuracion de nginx para servir la SPA.
# El entrypoint de la imagen sustituye ${PORT} en el arranque (Cloud Run lo
# inyecta). Las variables de nginx como $uri no llevan llaves y no se tocan.

server {
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/security-headers.conf;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_types        text/plain text/css application/javascript application/json image/svg+xml;

    # Los assets llevan hash en el nombre: se pueden cachear indefinidamente.
    # El include se repite porque este bloque declara su propio add_header y
    # eso descarta los heredados del servidor.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files  $uri =404;
    }

    # index.html nunca se cachea: es quien apunta a los assets vigentes.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # Fallback de React Router: cualquier ruta desconocida devuelve la SPA.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
