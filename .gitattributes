# Normaliza finales de linea: el repositorio guarda siempre LF.
* text=auto eol=lf

*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.template text eol=lf
Dockerfile text eol=lf

package-lock.json -diff linguist-generated

# Binarios
*.png binary
*.jpg binary
*.svg text eol=lf
*.woff  binary
*.woff2 binary
